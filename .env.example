# MongoDB Atlas SRV connection string (Database Access user + Network Access IP).
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/TechDrip?retryWrites=true&w=majority

MONGODB_DB=TechDrip
MONGODB_COLLECTION=passages

VECTOR_INDEX=passage_vector_index
SEARCH_INDEX=passage_search_index
EMBEDDING_MODEL=voyage-4

# Flask
SECRET_KEY=change-me
FLASK_DEBUG=0
